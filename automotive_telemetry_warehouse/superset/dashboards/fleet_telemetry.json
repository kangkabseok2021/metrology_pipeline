{
  "dashboard_title": "Fleet Telemetry — Battery Health & Geo Distribution",
  "description": "Battery-health line/box charts (mv_battery_health_daily) and a deck.gl GPS heatmap + scatter-plot (mv_fleet_geo_hourly), rendered via the read-only superset_ro role.",
  "metadata": {
    "color_scheme": "supersetColors",
    "refresh_frequency": 0,
    "expanded_slices": {}
  },
  "charts": [
    {
      "slice_name": "Battery Temp — 7-Day Rolling Average (line)",
      "viz_type": "echarts_timeseries_line",
      "datasource": "mv_battery_health_daily",
      "params": {
        "metrics": ["rolling_7d_avg_temp_c"],
        "groupby": ["model"],
        "x_axis": "day",
        "time_grain_sqla": "P1D"
      }
    },
    {
      "slice_name": "Battery Temp Distribution Widening Over Time (box plot)",
      "viz_type": "box_plot",
      "datasource": "mv_battery_health_daily",
      "params": {
        "metrics": ["avg_temp_c", "max_temp_c", "p95_temp_c"],
        "groupby": ["day"],
        "whisker_options": "Min/max (no outliers)"
      }
    },
    {
      "slice_name": "Fleet GPS Heatmap (deck.gl)",
      "viz_type": "deck_screengrid",
      "datasource": "mv_fleet_geo_hourly",
      "params": {
        "spatial": {"type": "latlong", "lonCol": "lon_bucket", "latCol": "lat_bucket"},
        "size": "event_count",
        "grid_size": 25,
        "mapbox_style": "mapbox://styles/mapbox/dark-v9"
      }
    },
    {
      "slice_name": "Fleet GPS Scatter Plot (deck.gl)",
      "viz_type": "deck_scatter",
      "datasource": "mv_fleet_geo_hourly",
      "params": {
        "spatial": {"type": "latlong", "lonCol": "lon_bucket", "latCol": "lat_bucket"},
        "point_radius_fixed": {"type": "metric", "value": "event_count"},
        "color_picker": {"r": 0, "g": 122, "b": 255, "a": 0.8}
      }
    }
  ],
  "layout": {
    "rows": [
      ["Battery Temp — 7-Day Rolling Average (line)", "Battery Temp Distribution Widening Over Time (box plot)"],
      ["Fleet GPS Heatmap (deck.gl)", "Fleet GPS Scatter Plot (deck.gl)"]
    ]
  }
}
